# ── ELS 플랫폼 환경변수 템플릿 ──
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요. (.env 는 커밋되지 않습니다)
#   cp .env.example .env

# Django 시크릿 키 — 아래 명령으로 생성:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 필수: 비워 두면 운영 모드(DJANGO_DEBUG=1 이 아닌 경우)에서 서버가 기동을 거부한다.
DJANGO_SECRET_KEY=

# 개발 모드는 1, 그 외에는 전부 운영 모드.
# 기본값(이 줄이 아예 없을 때)은 0 = 운영이다. 켜야 켜진다 — 설정을 빠뜨렸을 때
# 오류 화면에 스택트레이스가 노출되는 쪽으로 넘어가지 않게 하기 위함.
DJANGO_DEBUG=1

# 접속 허용 호스트 (콤마 구분). 터널 도메인 추가 시 여기에.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 터널 https 도메인 (CSRF 신뢰). 예: https://els.example.com
DJANGO_CSRF_TRUSTED=

# ELS_Curator exe 가 엑셀을 만드는 폴더 (기본값은 settings.py 참고)
ELS_DOWNLOADS_DIR=

# 텔레그램 봇 (BotFather 토큰 / @userinfobot 에서 chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 개인 투자 알림(조기상환 판정·평가일 D-7/D-1·낙인 근접)을 받을 계정. 쉼표 구분.
# 미설정 시 기본 admin. 빈 값으로 두면 제한 없이 전 계정 발송(옛 동작).
# 집계성 알림(주간 다이제스트·배치 보고·헬스체크)에는 적용되지 않는다.
TELEGRAM_ALERT_USERNAMES=admin

# 알림 종류별 텔레그램 발송 스위치. 아래 4종은 2026-08-11 조 팀장 지시로
# 비활성화했다(기본값 0 = 꺼짐). 끄는 것은 텔레그램 발송뿐이고 판정·DB 기록·
# 웹 푸시는 그대로 돈다. 다시 켜려면 값을 1로 바꾸고 재기동하면 된다.
TELEGRAM_REDEMPTION_ALERT_ENABLED=0
TELEGRAM_KNOCKIN_ALERT_ENABLED=0
TELEGRAM_PRESET_MATCH_ALERT_ENABLED=0
TELEGRAM_WATCHLIST_DEADLINE_ALERT_ENABLED=0

# 베타 피드백 접수 알림. 위 4종과 달리 기본값 1(켜짐) — 사용자가 한 번 쓰고 마는
# 것이라 놓치면 회신 타이밍이 사라진다. 꺼도 기록은 관리자 화면에 남는다.
TELEGRAM_FEEDBACK_ALERT_ENABLED=1

# 알림·메일에 들어가는 사이트 주소 (미설정 시 http://localhost:8000)
SITE_URL=

# 비밀번호 재설정 메일 (Gmail 앱 비밀번호). 둘 다 채워야 실제 발송,
# 비우면 콘솔 출력으로 폴백한다.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# 웹 푸시 VAPID 키. 미설정 시 푸시 발송과 구독 버튼이 비활성화된다.
#   생성: python -c "from py_vapid import Vapid01; ..." (기존 키는 .env 에서 복사)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:

# AI 리서치 (자연어 → 검색 필터 변환). 미설정 시 해당 기능만 비활성.
ANTHROPIC_API_KEY=

# 구글 시트 동기화 피드(/portfolio/sync.json)의 접근 토큰.
# 비워 두면 엔드포인트가 404다(기본값 = 꺼짐). 로그인 세션을 못 쓰는 자리라
# 이 토큰이 유일한 자물쇠이므로 짧은 값을 쓰지 말 것.
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHEET_SYNC_TOKEN=

# 시트로 내보낼 포트폴리오의 주인 계정. 미설정 시 admin(운영 DB 기준).
# 로컬 개발 DB는 보유분이 taehoon 계정에 있어 값이 다르다.
SHEET_SYNC_USERNAME=admin

# 카카오 로그인. 카카오 개발자센터(developers.kakao.com)에서 애플리케이션을
# 만들고 [앱 키]의 REST API 키를 KAKAO_CLIENT_ID 에, [보안]의 Client Secret 을
# KAKAO_SECRET 에 넣는다. 동의항목에서 '카카오계정(이메일)'과 '닉네임'을 켜야
# 설정한 SCOPE 가 실제로 넘어온다.
# 비우면(기본값) 소셜 로그인이 통째로 꺼진다 — 로그인·가입 화면에 카카오 버튼이
# 그려지지 않고, /accounts/kakao/login/ 으로 직접 들어와도 에러 화면 대신
# 로그인 화면으로 되돌린다. 즉 키가 없어도 서비스는 그대로 돈다.
# 카카오 개발자센터의 Redirect URI 에는 아래 두 줄을 등록한다.
#   http://localhost:8000/accounts/kakao/login/callback/
#   https://<운영 도메인>/accounts/kakao/login/callback/
KAKAO_CLIENT_ID=
KAKAO_SECRET=
