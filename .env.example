# ── ELS 플랫폼 환경변수 템플릿 ──
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요. (.env 는 커밋되지 않습니다)
#   cp .env.example .env

# Django 시크릿 키 — 아래 명령으로 생성:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 필수: 비워 두면 운영 모드(DJANGO_DEBUG=1 이 아닌 경우)에서 서버가 기동을 거부한다.
DJANGO_SECRET_KEY=

# 개발 모드는 1, 그 외에는 전부 운영 모드.
# 기본값(이 줄이 아예 없을 때)은 0 = 운영이다. 켜야 켜진다 — 설정을 빠뜨렸을 때
# 오류 화면에 스택트레이스가 노출되는 쪽으로 넘어가지 않게 하기 위함.
DJANGO_DEBUG=1

# 접속 허용 호스트 (콤마 구분). 터널 도메인 추가 시 여기에.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 터널 https 도메인 (CSRF 신뢰). 예: https://els.example.com
DJANGO_CSRF_TRUSTED=

# ELS_Curator exe 가 엑셀을 만드는 폴더 (기본값은 settings.py 참고)
ELS_DOWNLOADS_DIR=

# 텔레그램 봇 (BotFather 토큰 / @userinfobot 에서 chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 알림·메일에 들어가는 사이트 주소 (미설정 시 http://localhost:8000)
SITE_URL=

# 비밀번호 재설정 메일 (Gmail 앱 비밀번호). 둘 다 채워야 실제 발송,
# 비우면 콘솔 출력으로 폴백한다.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# 웹 푸시 VAPID 키. 미설정 시 푸시 발송과 구독 버튼이 비활성화된다.
#   생성: python -c "from py_vapid import Vapid01; ..." (기존 키는 .env 에서 복사)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:

# AI 리서치 (자연어 → 검색 필터 변환). 미설정 시 해당 기능만 비활성.
ANTHROPIC_API_KEY=
